<header class="navbar navbar-expand-md d-none d-lg-flex d-print-none">
    <div class="container-xl">
        <div class="navbar-nav flex-row order-md-last ms-auto gap-2 align-items-center">
            <span class="text-muted small" id="topbarContent"></span>

            <div class="nav-item dropdown">
                <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Felhasználói menü">
                    <span class="avatar avatar-sm">
                        <img id="AvatarImageTop" src="/noimage.png" alt="Avatar" style="border-radius: 50%; width: 32px; height: 32px; object-fit: cover;">
                    </span>
                </a>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <a asp-area="" asp-page="/Profiles/MyProfile" class="dropdown-item">
                        <i class="fas fa-user-circle me-2 text-muted"></i>Profilom
                    </a>
                    <div class="dropdown-divider"></div>
                    <form asp-area="" asp-page="/Accounts/Logout">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="fas fa-sign-out-alt me-2"></i>Kijelentkezés
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sideAvatar = document.getElementById('AvatarImageSide');
        const topAvatar = document.getElementById('AvatarImageTop');

        async function loadAvatar() {
            try {
                const avatar = StorageManager.getAvatar();
                if (!avatar) return;
                const response = await AxiosManager.get('/FileImage/GetImage?imageName=' + avatar, { responseType: 'blob' });
                if (response.status === 200) {
                    const reader = new FileReader();
                    reader.onloadend = function () {
                        const src = reader.result;
                        if (sideAvatar) sideAvatar.src = src;
                        if (topAvatar) topAvatar.src = src;
                    };
                    reader.readAsDataURL(response.data);
                }
            } catch (e) { console.error('Avatar load error:', e); }
        }

        async function loadCompany() {
            try {
                const response = await AxiosManager.get('/Company/GetCompanyList', {});
                const data = response?.data?.content?.data;
                if (data && data.length > 0) {
                    StorageManager.saveCompany(data[0]);
                    const currency = data[0]?.currency ?? '';
                    const el = document.getElementById('topbarContent');
                    if (el) el.textContent = currency ? `Pénznem: ${currency}` : '';
                }
            } catch (e) { console.error('Company load error:', e); }
        }

        loadAvatar();
        loadCompany();
    });
</script>
