@page
@{
    ViewData["Title"] = "Termék lista";
}

<input type="file" id="excelImportInput" accept=".xlsx" style="display:none" />

<div id="app" v-cloak>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>


    <div class="modal fade"
         ref="mainModalRef"
         id="MainModal"
         aria-hidden="true"
         tabindex="-1"
         data-bs-focus="false"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-dialog-centered modal-xl">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        {{ state.mainTitle }}
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           v-model="state.id" />


                    <form id="MainForm">

                        <!-- BASIC -->

                        <div class="card mb-3">

                            <div class="card-header">
                                <h5>Alapadatok</h5>
                            </div>


                            <div class="card-body">

                                <div class="row mb-2">

                                    <div class="col-md-6">

                                        <label>Név</label>

                                        <input ref="nameRef"
                                               v-model="state.name"
                                               class="form-control">

                                        <label class="text-danger">
                                            {{ state.errors.name }}
                                        </label>

                                    </div>


                                    <div class="col-md-6">

                                        <label>Szám</label>

                                        <input ref="numberRef"
                                               v-model="state.number"
                                               class="form-control">

                                    </div>

                                </div>



                                <div class="row mb-2">

                                    <div class="col-md-6">

                                        <label>Egységár</label>

                                        <input ref="unitPriceRef"
                                               v-model="state.unitPrice"
                                               class="form-control">

                                        <label class="text-danger">
                                            {{ state.errors.unitPrice }}
                                        </label>

                                    </div>


                                    <div class="col-md-6">

                                        <label>Mértékegység</label>

                                        <div ref="unitMeasureIdRef"></div>

                                        <label class="text-danger">
                                            {{ state.errors.unitMeasureId }}
                                        </label>

                                    </div>

                                </div>



                                <div class="row mb-2">

                                    <div class="col-md-6">

                                        <label>Termékcsoport</label>

                                        <div ref="productGroupIdRef"></div>

                                        <label class="text-danger">
                                            {{ state.errors.productGroupId }}
                                        </label>

                                    </div>


                                    <div class="col-md-6">

                                        <div class="form-check mt-4">

                                            <input v-model="state.physical"
                                                   type="checkbox"
                                                   class="form-check-input">

                                            <label class="form-check-label">
                                                Fizikai termék
                                            </label>

                                        </div>

                                    </div>

                                </div>



                                <div class="row">

                                    <div class="col-md-12">

                                        <label>Leírás</label>

                                        <textarea v-model="state.description"
                                              class="form-control"
                                                  rows="3">
                                        </textarea>

                                    </div>

                                </div>

                            </div>

                        </div>



                        <!-- MANUFACTURER -->

                        <div class="card mb-3">

                            <div class="card-header">
                                <h5>Gyártó</h5>
                            </div>


                            <div class="card-body">

                                <div class="row mb-2">

                                    <div class="col-md-6">

                                        <label>Gyár neve</label>

                                        <input v-model="state.factoryName"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-6">

                                        <label>Gyártó</label>

                                        <input v-model="state.manufacturer"
                                               class="form-control">

                                    </div>

                                </div>



                                <div class="row mb-2">

                                    <div class="col-md-6">

                                        <label>Gyártói szám</label>

                                        <input v-model="state.manufacturerNumber"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-6">

                                        <label>EAN</label>

                                        <input v-model="state.ean"
                                               class="form-control">

                                    </div>

                                </div>



                                <div class="row">

                                    <div class="col-md-6">

                                        <label>Márka</label>

                                        <div ref="brandIdRef"></div>

                                    </div>


                                    <div class="col-md-6">

                                        <label>Szín</label>

                                        <div ref="colorIdRef"></div>

                                    </div>

                                </div>

                            </div>

                        </div>



                        <!-- QUANTITY -->

                        <div class="card mb-3">

                            <div class="card-header">
                                <h5>Mennyiségek</h5>
                            </div>


                            <div class="card-body">

                                <div class="row mb-2">

                                    <div class="col-md-3">

                                        <label>Értékesítési menny.</label>

                                        <input v-model="state.salesUnitQuantity"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-3">

                                        <label>Min. értékesítési menny.</label>

                                        <input v-model="state.minimumSalesQuantity"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-3">

                                        <label>Rendelési lépés</label>

                                        <input v-model="state.orderQuantityStep"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-3">

                                        <label>Csomag menny.</label>

                                        <input v-model="state.packageQuantity"
                                               class="form-control">

                                    </div>

                                </div>



                                <div class="row">

                                    <div class="col-md-3">

                                        <label>Súly</label>

                                        <input v-model="state.weight"
                                               class="form-control">

                                    </div>

                                </div>

                            </div>

                        </div>



                        <!-- STOCK -->

                        <div class="card mb-3">

                            <div class="card-header">
                                <h5>Készlet</h5>
                            </div>


                            <div class="card-body">

                                <div class="row mb-2">

                                    <div class="col-md-3">

                                        <div class="form-check mt-4">

                                            <input v-model="state.isStockProduct"
                                                   type="checkbox"
                                                   class="form-check-input">

                                            <label class="form-check-label">
                                                Készletes termék
                                            </label>

                                        </div>

                                    </div>


                                    <div class="col-md-3">

                                        <label>Figyelmeztető készlet</label>

                                        <input v-model="state.warningStock"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-3">

                                        <label>Minimum készlet</label>

                                        <input v-model="state.minimumStock"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-3">

                                        <div class="form-check mt-4">

                                            <input v-model="state.hasSerialNumber"
                                                   type="checkbox"
                                                   class="form-check-input">

                                            <label class="form-check-label">
                                                Sorozatszám követés
                                            </label>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>



                        <!-- MEDIA -->

                        <div class="card mb-3">

                            <div class="card-header">
                                <h5>Média</h5>
                            </div>


                            <div class="card-body">

                                <div class="row mb-2">

                                    <div class="col-md-6">

                                        <label>1. kép</label>

                                        <input v-model="state.image1Url"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-6">

                                        <label>2. kép</label>

                                        <input v-model="state.image2Url"
                                               class="form-control">

                                    </div>

                                </div>



                                <div class="row mb-2">

                                    <div class="col-md-6">

                                        <label>3. kép</label>

                                        <input v-model="state.image3Url"
                                               class="form-control">

                                    </div>


                                    <div class="col-md-6">

                                        <label>Videó</label>

                                        <input v-model="state.videoUrl"
                                               class="form-control">

                                    </div>

                                </div>



                                <div class="row">

                                    <div class="col-md-12">

                                        <label>PDF</label>

                                        <input v-model="state.pdfUrl"
                                               class="form-control">

                                    </div>

                                </div>

                            </div>

                        </div>



                        <!-- FINANCE -->

                        <div class="card">

                            <div class="card-header">
                                <h5>Pénzügy</h5>
                            </div>


                            <div class="card-body">

                                <div class="row">

                                    <div class="col-md-4">

                                        <label>Beszerzési pénznem</label>

                                        <div ref="purchaseCurrencyRef"></div>

                                    </div>


                                    <div class="col-md-4">

                                        <label>Értékesítési pénznem</label>

                                        <div ref="salesCurrencyRef"></div>

                                    </div>


                                    <div class="col-md-4">

                                        <label>Státusz</label>

                                        <div ref="statusRef"></div>

                                    </div>

                                </div>

                            </div>

                        </div>


                    </form>

                </div>



                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Bezárás

                    </button>


                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">

                        <span class="spinner-border spinner-border-sm me-2"
                              v-if="state.isSubmitting">
                        </span>

                        <span v-if="!state.isSubmitting">

                            {{ state.deleteMode ? 'Törlés' : 'Mentés' }}

                        </span>

                        <span v-else>

                            {{ state.deleteMode ? 'Törlés...' : 'Mentés...' }}

                        </span>

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>



@section scripts {

    <script src="~/FrontEnd/Pages/Products/ProductList.cshtml.js"></script>

}