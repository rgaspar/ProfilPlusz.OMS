@page
@{
    ViewData["Title"] = "Termék lista";
}

<input type="file" id="excelImportInput" accept=".xlsx" style="display:none" />

<div id="app" v-cloak>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>


    <div class="modal fade"
         ref="mainModalRef"
         id="MainModal"
         aria-hidden="true"
         tabindex="-1"
         data-bs-focus="false"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-dialog-centered modal-xl">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" v-model="state.id" />

                    <form id="MainForm">

                        <ul class="nav nav-tabs mb-3" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-alapadatok" type="button">Alapadatok</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-gyarto" type="button">Gyártó</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mennyiseg" type="button">Mennyiségek</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-keszlet" type="button">Készlet</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-media" type="button">Média</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-penzugy" type="button">Pénzügy</button>
                            </li>
                        </ul>

                        <div class="tab-content">

                            <!-- ALAPADATOK -->
                            <div class="tab-pane fade show active" id="tab-alapadatok">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Név <span class="text-danger">*</span></label>
                                        <input ref="nameRef" v-model="state.name" class="form-control" />
                                        <div class="form-text text-danger" v-text="state.errors.name"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Kód</label>
                                        <input ref="numberRef" v-model="state.number" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Egységár <span class="text-danger">*</span></label>
                                        <input ref="unitPriceRef" v-model="state.unitPrice" class="form-control" />
                                        <div class="form-text text-danger" v-text="state.errors.unitPrice"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Mértékegység <span class="text-danger">*</span></label>
                                        <div ref="unitMeasureIdRef"></div>
                                        <div class="form-text text-danger" v-text="state.errors.unitMeasureId"></div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Termékcsoport <span class="text-danger">*</span></label>
                                        <div ref="productGroupIdRef"></div>
                                        <div class="form-text text-danger" v-text="state.errors.productGroupId"></div>
                                    </div>
                                    <div class="col-md-6"></div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <label class="form-label">Leírás</label>
                                        <textarea v-model="state.description" class="form-control" rows="3"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- GYÁRTÓ -->
                            <div class="tab-pane fade" id="tab-gyarto">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Gyár neve</label>
                                        <input v-model="state.factoryName" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Gyártó</label>
                                        <input v-model="state.manufacturer" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Gyártói szám</label>
                                        <input v-model="state.manufacturerNumber" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">EAN</label>
                                        <input v-model="state.ean" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Márka</label>
                                        <select v-model="state.brandId" class="form-select">
                                            <option :value="null">-- válassz --</option>
                                            <option v-for="b in state.brandListLookupData" :key="b.id" :value="b.id">{{ b.name }}</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Szín</label>
                                        <select v-model="state.colorId" class="form-select">
                                            <option :value="null">-- válassz --</option>
                                            <option v-for="c in state.colorListLookupData" :key="c.id" :value="c.id">{{ c.name }}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- MENNYISÉGEK -->
                            <div class="tab-pane fade" id="tab-mennyiseg">
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Értékesítési menny.</label>
                                        <input v-model="state.salesUnitQuantity" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Min. értékesítési menny.</label>
                                        <input v-model="state.minimumSalesQuantity" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Rendelési lépés</label>
                                        <input v-model="state.orderQuantityStep" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Csomag menny.</label>
                                        <input v-model="state.packageQuantity" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Súly</label>
                                        <input v-model="state.weight" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Hossz</label>
                                        <input v-model="state.length" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <!-- KÉSZLET -->
                            <div class="tab-pane fade" id="tab-keszlet">
                                <div class="row mb-3">
                                    <div class="col-md-3 d-flex align-items-end">
                                        <div class="form-check mb-1">
                                            <input v-model="state.isStockProduct" type="checkbox" class="form-check-input" id="chkStockProduct" />
                                            <label class="form-check-label" for="chkStockProduct">Készletes termék</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Figyelmeztető készlet</label>
                                        <input v-model="state.warningStock" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Minimum készlet</label>
                                        <input v-model="state.minimumStock" class="form-control" />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <div class="form-check mb-1">
                                            <input v-model="state.hasSerialNumber" type="checkbox" class="form-check-input" id="chkSerialNumber" />
                                            <label class="form-check-label" for="chkSerialNumber">Sorozatszám követés</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- MÉDIA -->
                            <div class="tab-pane fade" id="tab-media">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">1. kép</label>
                                        <input v-model="state.image1Url" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">2. kép</label>
                                        <input v-model="state.image2Url" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">3. kép</label>
                                        <input v-model="state.image3Url" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Videó</label>
                                        <input v-model="state.videoUrl" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <label class="form-label">PDF</label>
                                        <input v-model="state.pdfUrl" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <!-- PÉNZÜGY -->
                            <div class="tab-pane fade" id="tab-penzugy">
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Beszerzési pénznem</label>
                                        <select v-model="state.purchaseCurrency" class="form-select">
                                            <option value="HUF">HUF</option>
                                            <option value="EUR">EUR</option>
                                            <option value="USD">USD</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Értékesítési pénznem</label>
                                        <select v-model="state.salesCurrency" class="form-select">
                                            <option value="HUF">HUF</option>
                                            <option value="EUR">EUR</option>
                                            <option value="USD">USD</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Státusz</label>
                                        <select v-model="state.status" class="form-select">
                                            <option value="Active">Aktív</option>
                                            <option value="Inactive">Inaktív</option>
                                            <option value="Blocked">Blokkolt</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </form>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                    <button type="button"
                            class="btn btn-outline-primary me-auto"
                            v-if="state.id !== '' && !state.deleteMode"
                            v-on:click="handler.handleOpenPriceList">
                        Árlista
                    </button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Törlés' : 'Mentés' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Törlés...' : 'Mentés...' }}</span>
                    </button>
                </div>

            </div>

        </div>

    </div>


    <div class="modal fade"
         ref="importResultModalRef"
         id="ImportResultModal"
         aria-hidden="true"
         tabindex="-1"
         data-bs-focus="false"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Import eredmény</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="row mb-3">
                        <div class="col-4 text-center">
                            <div class="card bg-success text-white">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold">{{ state.importResult.successCount }}</div>
                                    <div class="small">Sikeres</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="card bg-warning text-dark">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold">{{ state.importResult.overwriteCount }}</div>
                                    <div class="small">Felülírva</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="card bg-danger text-white">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold">{{ state.importResult.errorCount }}</div>
                                    <div class="small">Hibás</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div v-if="state.importResult.errors && state.importResult.errors.length > 0">
                        <h6 class="text-danger mb-2">Hibás sorok:</h6>
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-bordered table-striped">
                                <thead class="table-danger sticky-top">
                                    <tr>
                                        <th style="width: 80px;">Sor</th>
                                        <th>Hiba</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="err in state.importResult.errors" :key="err.rowNumber">
                                        <td class="text-center">{{ err.rowNumber }}</td>
                                        <td>{{ err.errorMessage }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                </div>

            </div>
        </div>

    </div>

    <!-- Price List Modal -->
    <div class="modal fade"
         ref="priceListModalRef"
         id="PriceListModal"
         aria-hidden="true"
         tabindex="-1"
         data-bs-focus="false"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Árlista - {{ state.selectedProductName }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div ref="priceListGridRef"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                </div>

            </div>
        </div>
    </div>

    <!-- Price List Edit Modal -->
    <div class="modal fade"
         ref="priceListEditModalRef"
         id="PriceListEditModal"
         aria-hidden="true"
         tabindex="-1"
         data-bs-focus="false"
         data-bs-backdrop="static">

        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">{{ state.plEditTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div v-show="state.plDeleteMode" class="alert alert-danger">
                        Biztosan törölni szeretné ezt az árlistarekordot?
                    </div>

                    <div v-show="!state.plDeleteMode">
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Vevő</label>
                                <div ref="plCustomerIdRef"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ÁFA</label>
                                <div ref="plTaxIdRef"></div>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Nettó ár</label>
                                <input v-model="state.plNetPrice" type="number" step="0.01" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Bruttó ár</label>
                                <input v-model="state.plGrossPrice" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-4">
                                <label class="form-label">Mennyiségi kedvezmény (%)</label>
                                <input v-model="state.plQuantityDiscount" type="number" step="0.01" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Kedvezménytől</label>
                                <input v-model="state.plDiscountFrom" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Kedvezményig</label>
                                <input v-model="state.plDiscountTo" type="date" class="form-control" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button>
                    <button type="button"
                            :class="state.plDeleteMode ? 'btn btn-danger' : 'btn btn-primary'"
                            :disabled="state.plIsSubmitting"
                            v-on:click="handler.handlePriceListSubmit">
                        {{ state.plDeleteMode ? 'Törlés' : 'Mentés' }}
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>



@section scripts {

    <script src="~/FrontEnd/Pages/Products/ProductList.cshtml.js"></script>

}
