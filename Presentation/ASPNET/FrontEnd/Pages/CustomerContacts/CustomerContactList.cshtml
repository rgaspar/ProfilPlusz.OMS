@page
@{
    ViewData["Title"] = "Kapcsolattartó lista";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" v-text="state.mainTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />
                    <form id="MainForm">

                        <ul class="nav nav-tabs mb-3" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-alapadatok" type="button">Alapadatok</button>
                            </li>
                        </ul>

                        <div class="tab-content">

                            <!-- ALAPADATOK -->
                            <div class="tab-pane fade show active" id="tab-alapadatok">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Név <span class="text-danger">*</span></label>
                                        <input v-model="state.name" class="form-control" />
                                        <div class="form-text text-danger" v-text="state.errors.name"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Kód</label>
                                        <input v-model="state.number" class="form-control" readonly />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Munkakör <span class="text-danger">*</span></label>
                                        <input v-model="state.jobTitle" class="form-control" />
                                        <div class="form-text text-danger" v-text="state.errors.jobTitle"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Ügyfél <span class="text-danger">*</span></label>
                                        <div ref="customerIdRef"></div>
                                        <div class="form-text text-danger" v-text="state.errors.customerId"></div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Telefonszám <span class="text-danger">*</span></label>
                                        <input v-model="state.phoneNumber" class="form-control" type="tel" />
                                        <div class="form-text text-danger" v-text="state.errors.phoneNumber"></div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <label class="form-label">Leírás</label>
                                        <textarea v-model="state.description" class="form-control" rows="3"></textarea>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Törlés' : 'Mentés' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Törlés...' : 'Mentés...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/CustomerContacts/CustomerContactList.cshtml.js"></script>
}
