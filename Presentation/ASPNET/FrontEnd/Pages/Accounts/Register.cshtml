@page
@{
    ViewData["Title"] = "Regisztráció";
}
<div id="app" class="container-fluid" v-cloak>

    <div class="card-body register-card-body">
        <p class="login-box-msg">Regisztráció nem elérhető</p>

        <div class="text-center mb-3">
            <p class="text-muted">Az önálló regisztráció le van tiltva.</p>
            <p class="text-muted">Hozzáféréshez forduljon a rendszergazdához.</p>
        </div>

        <p class="mb-1">
            <a asp-page="/Accounts/Login" class="text-center">Vissza a bejelentkezéshez</a>
        </p>
    </div>

</div>
