@page
@{
    ViewData["Title"] = "Bejelentkezés";
}

<div id="app" v-cloak>
    <h2 class="h2 text-center mb-4">Bejelentkezés</h2>

    <form v-on:submit.prevent="handleSubmit">
        <div class="mb-3">
            <label class="form-label">E-mail cím</label>
            <input type="email"
                   class="form-control"
                   placeholder="name@example.com"
                   v-model="state.email"
                   v-on:input="state.errors.email = ''"
                   autocomplete="email" />
            <div class="form-text text-danger" v-if="state.errors.email">{{ state.errors.email }}</div>
        </div>

        <div class="mb-3">
            <label class="form-label">
                Jelszó
                <span class="form-label-description">
                    <a asp-page="/Accounts/ForgotPassword">Elfelejtett jelszó</a>
                </span>
            </label>
            <input type="password"
                   class="form-control"
                   placeholder="Jelszó"
                   v-model="state.password"
                   v-on:input="state.errors.password = ''"
                   autocomplete="current-password" />
            <div class="form-text text-danger" v-if="state.errors.password">{{ state.errors.password }}</div>
        </div>

        <div class="form-footer">
            <button type="submit"
                    class="btn btn-primary w-100"
                    v-bind:disabled="state.isSubmitting">
                <span class="spinner-border spinner-border-sm me-2"
                      v-if="state.isSubmitting"
                      role="status"
                      aria-hidden="true"></span>
                {{ state.isSubmitting ? 'Bejelentkezés...' : 'Bejelentkezés' }}
            </button>
        </div>
    </form>
</div>

@section scripts {
    <script type="module" src="~/FrontEnd/Pages/Accounts/Login.cshtml.js"></script>
}
