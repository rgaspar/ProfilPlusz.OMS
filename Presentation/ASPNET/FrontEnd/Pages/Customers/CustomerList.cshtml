@page
@{
    ViewData["Title"] = "Ügyfél lista";
}

<input type="file" id="excelImportInput" accept=".xlsx" style="display:none" />

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" v-text="state.mainTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />
                    <form id="MainForm">

                        <ul class="nav nav-tabs mb-3" id="customerTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-alapadatok" type="button">Alapadatok</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-kapcsolattarto" type="button">Kapcsolattartó</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-adozas" type="button">Adózás</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-email" type="button">E-mail</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cim" type="button">Cím</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-penzugy" type="button">Pénzügy</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-egyeb" type="button">Egyéb</button>
                            </li>
                        </ul>

                        <div class="tab-content">

                            <!-- ALAPADATOK -->
                            <div class="tab-pane fade show active" id="tab-alapadatok">
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Ügyfél kód</label>
                                        <input v-model="state.number" class="form-control" readonly />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Ügyfél neve <span class="text-danger">*</span></label>
                                        <input v-model="state.name" class="form-control" />
                                        <div class="form-text text-danger" v-text="state.errors.name"></div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Leírás</label>
                                        <input v-model="state.description" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Ügyfélcsoport <span class="text-danger">*</span></label>
                                        <div ref="customerGroupIdRef"></div>
                                        <div class="form-text text-danger" v-text="state.errors.customerGroupId"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Ügyfélkategória <span class="text-danger">*</span></label>
                                        <div ref="customerCategoryIdRef"></div>
                                        <div class="form-text text-danger" v-text="state.errors.customerCategoryId"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- KAPCSOLATTARTÓ -->
                            <div class="tab-pane fade" id="tab-kapcsolattarto">
                                <div class="table-responsive mb-2">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Név <span class="text-danger">*</span></th>
                                                <th style="width:140px">Beosztás</th>
                                                <th style="width:130px">Telefon</th>
                                                <th style="width:170px">E-mail</th>
                                                <th style="width:170px">E-mail visszaigazolás</th>
                                                <th style="width:170px">E-mail számlázás</th>
                                                <th style="width:170px">E-mail beszerzés</th>
                                                <th>Megjegyzés</th>
                                                <th style="width:40px"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="(contact, idx) in state.contacts" :key="idx">
                                                <td><input v-model="contact.name" class="form-control form-control-sm" placeholder="Kötelező" /></td>
                                                <td><input v-model="contact.jobTitle" class="form-control form-control-sm" /></td>
                                                <td><input v-model="contact.phoneNumber" class="form-control form-control-sm" /></td>
                                                <td><input v-model="contact.emailAddress" class="form-control form-control-sm" type="email" /></td>
                                                <td><input v-model="contact.emailAddressOrderConfirmation" class="form-control form-control-sm" type="email" /></td>
                                                <td><input v-model="contact.emailAddressInvoice" class="form-control form-control-sm" type="email" /></td>
                                                <td><input v-model="contact.emailAddressPurchaseOrder" class="form-control form-control-sm" type="email" /></td>
                                                <td><input v-model="contact.description" class="form-control form-control-sm" /></td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" v-on:click="handler.removeContact(idx)" :disabled="state.deleteMode">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            <tr v-if="state.contacts.length === 0">
                                                <td colspan="9" class="text-center text-muted py-2" style="font-size:0.85rem">Nincs rögzített kapcsolattartó</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="handler.addContact" :disabled="state.deleteMode">
                                    <i class="fa fa-plus me-1"></i>Kapcsolattartó hozzáadása
                                </button>
                            </div>

                            <!-- ADÓZÁS -->
                            <div class="tab-pane fade" id="tab-adozas">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Adószám</label>
                                        <input v-model="state.taxNumber" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Közösségi adószám</label>
                                        <input v-model="state.euTaxNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <!-- EMAIL -->
                            <div class="tab-pane fade" id="tab-email">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">E-mail (általános) <span class="text-danger">*</span></label>
                                        <input v-model="state.emailAddress" class="form-control" type="email" />
                                        <div class="form-text text-danger" v-text="state.errors.emailAddress"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- CÍM -->
                            <div class="tab-pane fade" id="tab-cim">
                                <div class="table-responsive mb-2">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width:140px">Típus</th>
                                                <th style="width:80px">Ország</th>
                                                <th style="width:90px">Irsz.</th>
                                                <th>Város</th>
                                                <th>Utca, házszám</th>
                                                <th style="width:40px"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="(addr, idx) in state.addresses" :key="idx">
                                                <td>
                                                    <select v-model="addr.type" class="form-select form-select-sm">
                                                        <option :value="1">Számlázási</option>
                                                        <option :value="2">Szállítási</option>
                                                        <option :value="4">Székhely</option>
                                                    </select>
                                                </td>
                                                <td><input v-model="addr.country" class="form-control form-control-sm" /></td>
                                                <td><input v-model="addr.zipCode" class="form-control form-control-sm" /></td>
                                                <td><input v-model="addr.city" class="form-control form-control-sm" /></td>
                                                <td><input v-model="addr.street" class="form-control form-control-sm" /></td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" v-on:click="handler.removeAddress(idx)" :disabled="state.deleteMode">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            <tr v-if="state.addresses.length === 0">
                                                <td colspan="6" class="text-center text-muted py-2" style="font-size:0.85rem">Nincs rögzített cím</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="handler.addAddress" :disabled="state.deleteMode">
                                    <i class="fa fa-plus me-1"></i>Cím hozzáadása
                                </button>
                            </div>

                            <!-- PÉNZÜGY -->
                            <div class="tab-pane fade" id="tab-penzugy">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Bankszámlaszám</label>
                                        <input v-model="state.bankAccountNumber" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Számla típusa</label>
                                        <select v-model="state.invoiceType" class="form-select">
                                            <option :value="null">-- válassz --</option>
                                            <option :value="1">Elektronikus</option>
                                            <option :value="2">Papír</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Fizetés módja</label>
                                        <select v-model="state.paymentMethod" class="form-select">
                                            <option :value="null">-- válassz --</option>
                                            <option :value="1">Átutalás</option>
                                            <option :value="2">Készpénz</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Fizetési határidő</label>
                                        <select v-model="state.paymentDeadlineDays" class="form-select">
                                            <option :value="null">-- válassz --</option>
                                            <option :value="8">8 nap</option>
                                            <option :value="15">15 nap</option>
                                            <option :value="30">30 nap</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Pénznem</label>
                                        <select v-model="state.currency" class="form-select">
                                            <option :value="null">-- válassz --</option>
                                            <option :value="1">HUF</option>
                                            <option :value="2">EUR</option>
                                            <option :value="3">USD</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- EGYÉB -->
                            <div class="tab-pane fade" id="tab-egyeb">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Weboldal</label>
                                        <input v-model="state.website" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Faxszám</label>
                                        <input v-model="state.faxNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Törlés' : 'Mentés' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Törlés...' : 'Mentés...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade"
         ref="importResultModalRef"
         id="ImportResultModal"
         aria-hidden="true"
         tabindex="-1"
         data-bs-focus="false"
         data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Import eredmény</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-6 text-center">
                            <div class="card bg-success text-white">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold">{{ state.importResult.successCount }}</div>
                                    <div class="small">Sikeres</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 text-center">
                            <div class="card bg-danger text-white">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold">{{ state.importResult.errorCount }}</div>
                                    <div class="small">Hibás</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div v-if="state.importResult.errors && state.importResult.errors.length > 0">
                        <h6 class="text-danger mb-2">Hibás sorok:</h6>
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-bordered table-striped">
                                <thead class="table-danger sticky-top">
                                    <tr>
                                        <th style="width: 80px;">Sor</th>
                                        <th>Hiba</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="err in state.importResult.errors" :key="err.rowNumber">
                                        <td class="text-center">{{ err.rowNumber }}</td>
                                        <td>{{ err.errorMessage }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Customers/CustomerList.cshtml.js"></script>
}
