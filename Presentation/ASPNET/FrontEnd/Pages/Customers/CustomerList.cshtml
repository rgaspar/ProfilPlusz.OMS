@page
@{
    ViewData["Title"] = "Ügyfél lista";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" v-text="state.mainTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />
                    <form id="MainForm">

                        <!-- ALAPADATOK -->
                        <div class="card mb-3">
                            <div class="card-header"><h5>Alapadatok</h5></div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <label>Ügyfél kód</label>
                                        <input ref="numberRef" v-model="state.number" class="form-control" readonly />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Ügyfél neve <span class="text-danger">*</span></label>
                                        <input ref="nameRef" v-model="state.name" class="form-control" />
                                        <label class="text-danger" v-text="state.errors.name"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Leírás</label>
                                        <input v-model="state.description" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label>Ügyfélcsoport <span class="text-danger">*</span></label>
                                        <div ref="customerGroupIdRef"></div>
                                        <label class="text-danger" v-text="state.errors.customerGroupId"></label>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Ügyfélkategória <span class="text-danger">*</span></label>
                                        <div ref="customerCategoryIdRef"></div>
                                        <label class="text-danger" v-text="state.errors.customerCategoryId"></label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- KAPCSOLATTARTÓ -->
                        <div class="card mb-3">
                            <div class="card-header"><h5>Kapcsolattartó</h5></div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label>Kapcsolattartó neve</label>
                                        <input v-model="state.contactPersonName" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label>Kapcsolattartó telefonszáma</label>
                                        <input v-model="state.phoneNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ADÓZÁS -->
                        <div class="card mb-3">
                            <div class="card-header"><h5>Adózás</h5></div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label>Adószám</label>
                                        <input v-model="state.taxNumber" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label>Közösségi adószám</label>
                                        <input v-model="state.euTaxNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- EMAIL CÍMEK -->
                        <div class="card mb-3">
                            <div class="card-header"><h5>E-mail címek</h5></div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label>E-mail (általános) <span class="text-danger">*</span></label>
                                        <input v-model="state.emailAddress" class="form-control" />
                                        <label class="text-danger" v-text="state.errors.emailAddress"></label>
                                    </div>
                                    <div class="col-md-6">
                                        <label>E-mail – rendelés visszaigazolás</label>
                                        <input v-model="state.emailAddressOrderConfirmation" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label>E-mail – számlázás</label>
                                        <input v-model="state.emailAddressInvoice" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label>E-mail – beszerzési rendelés</label>
                                        <input v-model="state.emailAddressPurchaseOrder" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CÍM -->
                        <div class="card mb-3">
                            <div class="card-header"><h5>Számlázási / szállítási cím</h5></div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-3">
                                        <label>Ország</label>
                                        <input v-model="state.country" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Irányítószám</label>
                                        <input v-model="state.zipCode" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Település</label>
                                        <input v-model="state.city" class="form-control" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Utca, házszám</label>
                                        <input v-model="state.street" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PÉNZÜGY -->
                        <div class="card mb-3">
                            <div class="card-header"><h5>Pénzügyi adatok</h5></div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label>Bankszámlaszám</label>
                                        <input v-model="state.bankAccountNumber" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label>Számla típusa</label>
                                        <div ref="invoiceTypeRef"></div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-md-4">
                                        <label>Fizetés módja</label>
                                        <div ref="paymentMethodRef"></div>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Fizetési határidő</label>
                                        <div ref="paymentDeadlineDaysRef"></div>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Pénznem</label>
                                        <div ref="currencyRef"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- EGYÉB KOMMUNIKÁCIÓ -->
                        <div class="card mb-3">
                            <div class="card-header"><h5>Egyéb kommunikáció</h5></div>
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label>Weboldal</label>
                                        <input v-model="state.website" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label>Faxszám</label>
                                        <input v-model="state.faxNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Törlés' : 'Mentés' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Törlés...' : 'Mentés...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="manageContactModalRef" id="ManageContactModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" v-text="state.manageContactTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Ügyfél kapcsolattartó</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="grid-container">
                                                <div ref="secondaryGridRef"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezárás</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Customers/CustomerList.cshtml.js"></script>
}
